    "fulcrum-startos": "github:Start9Labs/fulcrum-startos#v2.1.1_5",
    "electrs-startos": "github:Start9-Community/electrs-startos#v0.11.1_8",
    "tor-startos": "github:Start9Labs/tor-startos#v0.4.9.9_1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vercel/ncc": "^0.38.4",
